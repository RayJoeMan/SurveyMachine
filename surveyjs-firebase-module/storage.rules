rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.email == 'joermnd@gmail.com';
    }

    function hasAnyRole(orgId, requiredRoles) {
      let member = firestore.get(
        /databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)
      );
      return signedIn() && member.data.roles.hasAny(requiredRoles);
    }

    match /survey-exports/{orgId}/{surveyId}/{fileName} {
      allow read: if hasAnyRole(orgId, ['org_admin', 'survey_admin', 'report_viewer']) || isSuperAdmin();
      allow write: if false;
    }

    match /public-assets/{orgId}/{fileName} {
      allow read: if true;
      // Logo uploads: org_admin/super-admin only, images up to 2 MB.
      allow write: if signedIn()
        && fileName == 'logo'
        && (hasAnyRole(orgId, ['org_admin']) || isSuperAdmin())
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    // Photo-question uploads. Respondents (including anonymous) upload a single
    // image under an unguessable random token path. Reads are public so the survey
    // can display the image back to the respondent; type + size are enforced.
    match /survey-uploads/{orgId}/{surveyId}/{token}/{fileName} {
      allow read: if true;
      allow write: if token.matches('^[A-Za-z0-9_-]{16,}$')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|jpg|webp|gif|heic|heif|bmp|avif)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
