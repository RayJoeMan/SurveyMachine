# Environment files
# - apps/web/.env.development  -> emulator/demo config (VITE_USE_EMULATORS=true)
# - apps/web/.env.stage        -> dev hosting site (gitignored; copy this example, set VITE_ENVIRONMENT=stage)
# - apps/web/.env.production   -> prod hosting site (gitignored; this file shows the real values)
#
# Production example populated with the module's real Firebase web app.
# API keys for Firebase web apps are public configuration, not secrets.
VITE_ENVIRONMENT=production
VITE_FIREBASE_API_KEY=AIzaSyC0njoMuPm_WyHMLOysOzCu-cS194P4AdY
VITE_FIREBASE_AUTH_DOMAIN=survey-machine-766b8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=survey-machine-766b8
VITE_FIREBASE_STORAGE_BUCKET=survey-machine-766b8.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=729872333904
VITE_FIREBASE_APP_ID=1:729872333904:web:c5fbcfb5a7abfc7c932555
VITE_FIREBASE_MEASUREMENT_ID=G-8DRB2GCPJF
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_USE_EMULATORS=false
# Leave empty for a multi-tenant deployment so administrators choose their
# organization; optionally pin one (e.g. your own org id) for single-tenant.
VITE_DEFAULT_ORG_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
